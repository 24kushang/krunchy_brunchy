# ── sw.js: never cache, at browser OR Cloudflare's edge ────────────────────
# This is the one file that MUST always be revalidated: it's not
# content-hashed (same filename every deploy) and it's what tells the
# browser whether a new deploy exists. `max-age=0` covers the browser cache,
# `s-maxage=0` covers Cloudflare's own edge/CDN cache in front of Pages (a
# custom domain with its own Cache Rules can otherwise keep serving an old
# sw.js after a fresh deploy). Note: per the Service Worker spec, browsers
# already bypass HTTP cache for this exact fetch on registration/update
# checks — this header is belt-and-suspenders for the edge-cache case, which
# the spec doesn't cover.
/sw.js
  Cache-Control: public, max-age=0, s-maxage=0, must-revalidate

# registerSW.js is a regular page subresource (unlike sw.js, not spec-exempt
# from caching), also fixed-name — same treatment.
/registerSW.js
  Cache-Control: public, max-age=0, s-maxage=0, must-revalidate

# manifest.webmanifest: fixed name, changes rarely but should never be stuck
# stale at the edge. Cloudflare Pages sets the correct content-type
# automatically, but declaring it explicitly costs nothing.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=0, s-maxage=0, must-revalidate

# Workbox's runtime chunk IS content-hashed by vite-plugin-pwa (filename
# changes when its content does), so — unlike sw.js — it's safe and
# beneficial to cache it immutably forever, same as the hashed JS/CSS below.
/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

# Vite content-hashes JS/CSS filenames, so these are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
